{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "left": 2 } },
  "display": { "separator": " ✦ " },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name} — Adventurer of the Realm" },
    { "type": "custom", "format": "───────── ⟨ The Chronicles of Nethix ⟩ ─────────" },
    { "key": "Encumbrance", "type": "os" },
    { "key": "Spellbook", "type": "kernel" },
    { "key": "Journey Log", "type": "uptime" },
    { "key": "Familiar", "type": "shell" },
    { "key": "Paragon Level", "type": "packages" },
    { "key": "Forge", "type": "cpu", "format": "{name-without-core} ({cores-physical} cores, {frequency-max})" },
    { "key": "Arcane Graphics", "type": "gpu" },
    { "key": "Mana Pool", "type": "memory" },
    { "key": "Vault", "type": "disk" },
    { "key": "Party Members", "type": "localip" },
    { "key": "Summons", "type": "wm" },
    { "key": "Idle Quests", "type": "break" },
    { "type": "colors", "symbol": "circle" }
  ]
}