// Nethix fastfetch — Pathfinder 2e character sheet theme
// Renders with: fastfetch --config configs/fastfetch/nethix-pathfinder.jsonc
// Requires the Nethix ASCII art at configs/fastfetch/nethix-logo.txt

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "configs/fastfetch/nethix-logo.txt",
    "height": 22,
    "padding": { "top": 2, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " ",
    "key": { "width": 20 }
  },
  "modules": [
    "break",

    // Hero (identity)
    {
      "type": "title",
      "key": "╭─ Hero",
      "format": "{user-name} @ {host-name}",
      "keyColor": "yellow"
    },
    {
      "type": "os",
      "key": "├─ Origin",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "├─ Bloodline",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "key": "├─ Ancestry",
      "format": "Gentoo (via CachyOS patchset)",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "├─ Grimoire",
      "format": "{all} scrolls in the vault",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "╰─ Quest Time",
      "keyColor": "yellow"
    },

    "break",

    // Class (desktop identity)
    {
      "type": "wm",
      "key": "╭─ Class",
      "format": "{pretty-name} ({type})",
      "keyColor": "cyan"
    },
    {
      "type": "de",
      "key": "├─ Tradition",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "├─ Spellbook",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "├─ Cantrips",
      "keyColor": "cyan"
    },
    {
      "type": "terminalfont",
      "key": "╰─ Focus",
      "keyColor": "cyan"
    },

    "break",

    // Combat Stats (hardware as PF2e abilities)
    {
      "type": "cpu",
      "key": "╭─ STR - Might",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "├─ DEX - Dexterity",
      "format": "{vendor} {name}",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "├─ CON - Constitution",
      "format": "{used} / {total} HP",
      "keyColor": "red"
    },
    {
      "type": "swap",
      "key": "├─ FORT - Stamina",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "╰─ Inventory",
      "keyColor": "red"
    },

    "break",

    // Harrow Deck (colors)
    {
      "type": "colors",
      "key": "╰─ Harrow Deck",
      "symbol": "circle",
      "keyColor": "magenta"
    }
  ]
}
