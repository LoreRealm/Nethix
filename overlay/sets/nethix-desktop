sys-fs/e2fsprogs
sys-fs/xfsprogs
sys-fs/lvm2
sys-fs/mdadm
sys-fs/cryptsetup
sys-fs/squashfs-tools
sys-apps/smartmontools
sys-apps/dmidecode
sys-apps/hdparm
sys-block/gparted

# --- archiving ---
